{
  "name": "sfo-safe-file-organizer",
  "private": true,
  "version": "1.0.0",
  "main": "src/main.js",
  "description": "A desktop app for safely indexing and organizing files across your drives.",
  "author": "B&B Coder",
  "copyright": "Copyright © 2026 - B&B Coder",
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "preview": "vite preview"
  },
  "dependencies": {
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "build": {
    "appId": "com.sfo.safe-file-organizer",
    "productName": "SFO - Safe File Organizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SFO-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SFO - Safe File Organizer",
      "uninstallDisplayName": "SFO - Safe File Organizer",
      "deleteAppDataOnUninstall": false
    }
  }
}
